<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<!-- Se aplica -fx-base para activar el Tema Oscuro global automático -->
<BorderPane prefHeight="768.0" prefWidth="1280.0" style="-fx-base: #383838; -fx-background-color: #383838; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.photolab.MainController">

    <!-- 1. BARRA SUPERIOR -->
    <top>
        <VBox style="-fx-border-color: #222222; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <MenuBar style="-fx-padding: 2; -fx-font-size: 12px;">
                <Menu mnemonicParsing="false" text="Archivo">
                    <MenuItem accelerator="Shortcut+O" mnemonicParsing="false" onAction="#onOpenClick" text="Abrir imagen...">
                        <graphic>
                            <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" fill="#CCCCCC" scaleX="0.6" scaleY="0.6" />
                        </graphic>
                    </MenuItem>
                    <MenuItem accelerator="Shortcut+S" mnemonicParsing="false" onAction="#onSaveClick" text="Guardar imagen...">
                        <graphic>
                            <SVGPath content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" fill="#CCCCCC" scaleX="0.6" scaleY="0.6" />
                        </graphic>
                    </MenuItem>
                    <MenuItem accelerator="Shortcut+W" mnemonicParsing="false" onAction="#onCloseImageClick" text="Cerrar imagen" />
                    <SeparatorMenuItem />
                    <MenuItem accelerator="Shortcut+Q" mnemonicParsing="false" onAction="#onExitClick" text="Salir" />
                </Menu>
                <Menu mnemonicParsing="false" text="Imagen">
                    <Menu mnemonicParsing="false" text="Geometría y Recorte">
                        <MenuItem mnemonicParsing="false" onAction="#onRotate180Click" text="Rotar 180°" />
                        <MenuItem mnemonicParsing="false" onAction="#onRotate90RightClick" text="90° a la derecha" />
                        <MenuItem mnemonicParsing="false" onAction="#onRotate90LeftClick" text="90° a la izquierda" />
                        <SeparatorMenuItem />
                        <MenuItem mnemonicParsing="false" onAction="#onFlipHorizontalClick" text="Voltear horizontal" />
                        <MenuItem mnemonicParsing="false" onAction="#onFlipVerticalClick" text="Voltear vertical" />
                    </Menu>
                    <SeparatorMenuItem />
                    <Menu mnemonicParsing="false" text="Escala de Grises">
                        <MenuItem mnemonicParsing="false" onAction="#onGrayscaleAvgClick" text="Promedio" />
                        <MenuItem mnemonicParsing="false" onAction="#onGrayscaleLumaClick" text="Luma (Preciso)" />
                    </Menu>
                    <Menu mnemonicParsing="false" text="Colorear / Teñir">
                        <MenuItem mnemonicParsing="false" onAction="#onColorTintClick" text="Escala Monocromática" />
                        <SeparatorMenuItem />
                        <MenuItem mnemonicParsing="false" onAction="#onColorMultiplyClick" text="Oscurecer" />
                        <MenuItem mnemonicParsing="false" onAction="#onColorAddClick" text="Aclarar" />
                    </Menu>
                    <SeparatorMenuItem />
                    <MenuItem mnemonicParsing="false" onAction="#onNegativeClick" text="Negativo (Invertir)" />
                    <SeparatorMenuItem />
                    <Menu mnemonicParsing="false" text="Cuantización de Color">
                        <MenuItem mnemonicParsing="false" onAction="#onQuantizeBitsClick" text="Reducción de Bits" />
                        <MenuItem mnemonicParsing="false" onAction="#onQuantizePopularityClick" text="Algoritmo de Popularidad" />
                        <MenuItem mnemonicParsing="false" onAction="#onQuantizeKMeansClick" text="K-Means" />
                    </Menu>
                    <SeparatorMenuItem />
                    <MenuItem fx:id="menuUndo" accelerator="Shortcut+Z" disable="true" mnemonicParsing="false" onAction="#onUndoClick" text="Deshacer" />
                    <MenuItem fx:id="menuResetImage" accelerator="Shortcut+R" disable="true" mnemonicParsing="false" onAction="#onResetImageClick" text="Reiniciar Imagen" />
                </Menu>
                <Menu mnemonicParsing="false" text="Filtros">
                    <Menu mnemonicParsing="false" text="Suavizado">
                        <MenuItem mnemonicParsing="false" onAction="#onFilterAverageClick" text="Suavizar (Media)" />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterMedianClick" text="Eliminar Ruido (Mediana)" />
                    </Menu>
                    <Menu mnemonicParsing="false" text="Bordes">
                        <MenuItem mnemonicParsing="false" onAction="#onFilterSobelClick" text="Contornos Básicos (Sobel)" />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterScharrClick" text="Contornos Precisos (Scharr)" />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterRobertsClick" text="Contornos Finos (Roberts)" />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterPrewittClick" text="Contornos Estructurados (Prewitt)" />
                        <SeparatorMenuItem />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterLoGClick" text="Realzar Bordes (LoG)" />
                        <MenuItem mnemonicParsing="false" onAction="#onFilterSharpenClick" text="Perfilado (Sharpening)" />
                    </Menu>
                    <Menu mnemonicParsing="false" text="Ruido">
                        <MenuItem mnemonicParsing="false" onAction="#onNoiseSaltPepperClick" text="Sal y Pimienta" />
                        <MenuItem mnemonicParsing="false" onAction="#onNoiseGaussianClick" text="Gaussiano (Aditivo)" />
                    </Menu>
                </Menu>
                <Menu mnemonicParsing="false" text="Avanzado">
                    <MenuItem mnemonicParsing="false" onAction="#onCustomFilterClick" text="Filtro Personalizado..." />
                </Menu>
            </MenuBar>

            <ToolBar style="-fx-padding: 8 10 8 10; -fx-border-color: #4a4a4a; -fx-border-width: 1 0 0 0; -fx-background-color: #2D2D30;">
                <Button fx:id="btnUndoGlobal" disable="true" mnemonicParsing="false" onAction="#onUndoClick" style="-fx-background-color: #4a4a4a; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 12 6 12; -fx-cursor: hand; -fx-font-weight: bold;" text="Deshacer">
                    <graphic>
                        <SVGPath content="M12.5,8c-2.65,0-5.05,1-6.9,2.6L2,7v9h9l-3.62-3.62c1.39-1.16,3.16-1.88,5.12-1.88c3.54,0,6.55,2.31,7.6,5.5l2.37-0.78C21.08,11.03,17.15,8,12.5,8z" fill="#CCCCCC" scaleX="0.75" scaleY="0.75" />
                    </graphic>
                </Button>
                <Button fx:id="btnCompare" mnemonicParsing="false" style="-fx-background-color: #007ACC; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 12 6 12; -fx-cursor: hand; -fx-font-weight: bold;" text="Comparar" visible="false">
                    <graphic>
                        <SVGPath content="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" fill="white" scaleX="0.75" scaleY="0.75" />
                    </graphic>
                </Button>
                <Separator orientation="VERTICAL" style="-fx-padding: 0 5 0 5;" />
                <Button fx:id="btnResetImage" disable="true" mnemonicParsing="false" onAction="#onResetImageClick" style="-fx-background-color: #4a4a4a; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 12 6 12; -fx-cursor: hand; -fx-font-weight: bold;" text="Reiniciar Imagen">
                    <graphic>
                        <SVGPath content="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z" fill="#CCCCCC" scaleX="0.75" scaleY="0.75" />
                    </graphic>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- 2. BARRA LATERAL IZQUIERDA -->
    <left>
        <ToolBar orientation="VERTICAL" style="-fx-border-color: #222222; -fx-border-width: 0 1 0 0; -fx-padding: 10 10 10 10;" BorderPane.alignment="CENTER">
            <fx:define>
                <ToggleGroup fx:id="toolGroup" />
            </fx:define>
            <ToggleButton fx:id="btnToolPan" mnemonicParsing="false" selected="true" style="-fx-cursor: hand; -fx-min-width: 44px; -fx-min-height: 44px; -fx-background-radius: 6;" toggleGroup="$toolGroup">
                <graphic>
                    <SVGPath content="M21 9.5a1.5 1.5 0 0 0-1.5-1.5h-.09A1.5 1.5 0 0 0 18 7.16a1.5 1.5 0 0 0-1.5-.66v-.06a1.5 1.5 0 0 0-3 0v5.6L12.1 11a1.5 1.5 0 0 0-2.13.23l-3.32 4.14 5.3 5.3c.77.78 1.83 1.23 2.92 1.23h3.63c2.2 0 4-1.8 4-4v-8.5zm-2 8.5c0 1.1-.9 2-2 2h-3.63c-.53 0-1.04-.2-1.42-.58l-3.88-3.88 1.5-1.87 2.43 1.82V6.5a.5.5 0 0 1 1 0v4.5h1v-3a.5.5 0 0 1 1 0v3h1v-2.5a.5.5 0 0 1 1 0v2.5h1v-1.5a.5.5 0 0 1 1 0v8.5z" fill="#E0E0E0" scaleX="0.8" scaleY="0.8" />
                </graphic>
                <tooltip><Tooltip text="Mover lienzo" /></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="btnToolCrop" mnemonicParsing="false" style="-fx-cursor: hand; -fx-min-width: 44px; -fx-min-height: 44px; -fx-background-radius: 6;" toggleGroup="$toolGroup">
                <graphic>
                    <SVGPath content="M17 15h2V7c0-1.1-.9-2-2-2H9v2h8v8zM7 17V1H5v4H1v2h4v10c0 1.1.9 2 2 2h10v4h2v-4h4v-2H7z" fill="#E0E0E0" scaleX="0.8" scaleY="0.8" />
                </graphic>
                <tooltip><Tooltip text="Recortar" /></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="btnToolProfile" mnemonicParsing="false" style="-fx-cursor: hand; -fx-min-width: 44px; -fx-min-height: 44px; -fx-background-radius: 6;" toggleGroup="$toolGroup">
                <graphic>
                    <SVGPath content="M3.5 18.5l6-6 4 4L22 6.92 20.59 5.5l-7.09 7.58-4-4L3.5 15.68z M2 22h20v-2H2v2z" fill="#E0E0E0" scaleX="0.8" scaleY="0.8" />
                </graphic>
                <tooltip><Tooltip text="Perfil de Línea" /></tooltip>
            </ToggleButton>
        </ToolBar>
    </left>

    <!-- 3. CENTRO (Lienzo) -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background-color: #2b2b2b; -fx-background: #2b2b2b; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
            <StackPane fx:id="imageStackPane" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: #2b2b2b;">
                <ImageView fx:id="mainImageView" onMouseClicked="#onMainImageClick" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.9), 20, 0, 0, 0);" />
                <Canvas fx:id="overlayCanvas" mouseTransparent="true" />
            </StackPane>
        </ScrollPane>
    </center>

    <!-- 4. PANEL DERECHO -->
    <right>
        <ScrollPane fitToWidth="true" prefWidth="380.0" style="-fx-background-color: #383838; -fx-background: #383838; -fx-border-color: #222222; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <VBox spacing="2.0" style="-fx-background-color: #383838;">

                <!-- CONTENEDOR RECORTE -->
                <VBox fx:id="cropContainer" managed="false" spacing="12.0" style="-fx-background-color: #4a4a4a; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;" visible="false">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 0 0 0 8; -fx-border-color: #007ACC; -fx-border-width: 0 0 0 3;" text="HERRAMIENTA RECORTE" />
                    <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #404040; -fx-padding: 8; -fx-background-radius: 4; -fx-border-color: #4d4d4d; -fx-border-radius: 4;">
                        <RadioButton fx:id="rbCropDraw" selected="true" text="Dibujar" />
                        <RadioButton fx:id="rbCropPan" text="Mover" />
                    </HBox>
                    <Label style="-fx-font-size: 11px;" text="Arrastra el mouse sobre la imagen." textFill="#E0E0E0" wrapText="true" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox.margin><Insets top="5.0" /></VBox.margin>
                        <Label style="-fx-font-size: 11px;" text="Resolución:" textFill="#E0E0E0" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <TextField fx:id="txtCropResW" alignment="CENTER" editable="false" prefWidth="55" style="-fx-font-size: 12px;" text="0" />
                            <Label style="-fx-font-size: 11px;" text="x" textFill="#E0E0E0" />
                            <TextField fx:id="txtCropResH" alignment="CENTER" editable="false" prefWidth="55" style="-fx-font-size: 12px;" text="0" />
                            <Label style="-fx-font-size: 11px;" text="px" textFill="#E0E0E0" />
                        </HBox>
                    </HBox>
                    <HBox alignment="CENTER" spacing="10.0">
                        <Button onAction="#onApplyCrop" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 15 6 15;" text="Recortar" />
                        <Button onAction="#onClearCropSelection" style="-fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 6 15 6 15;" text="Limpiar" />
                    </HBox>
                </VBox>

                <!-- PANEL: ANÁLISIS E INFORMACIÓN -->
                <TitledPane fx:id="tpAnalysis" style="-fx-font-weight: bold;" text="Análisis e Información">
                    <VBox spacing="15.0" style="-fx-background-color: #383838; -fx-padding: 10;">

                        <!-- ZOOM -->
                        <VBox fx:id="zoomContainer" spacing="10.0" style="-fx-background-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 0 0 0 8; -fx-border-color: #007ACC; -fx-border-width: 0 0 0 3;" text="ZOOM / ESCALADO" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="60.0" text="Escala %" />
                                <Slider fx:id="sliderZoom" max="400.0" min="10.0" value="100.0" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtZoom" alignment="CENTER_RIGHT" prefWidth="55.0" text="100" />
                            </HBox>
                            <Label text="Método de Interpolación:"><VBox.margin><Insets top="5.0" /></VBox.margin></Label>
                            <ComboBox fx:id="comboInterpolation" maxWidth="Infinity" />
                            <HBox alignment="CENTER">
                                <Button onAction="#onApplyZoomClick" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 5 15 5 15;" text="Aplicar Zoom">
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </Button>
                            </HBox>
                        </VBox>

                        <!-- HISTOGRAMA -->
                        <VBox fx:id="histogramContainer" spacing="5.0" style="-fx-background-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 0 0 0 8; -fx-border-color: #007ACC; -fx-border-width: 0 0 0 3;" text="HISTOGRAMA" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Canal:" />
                                <ComboBox fx:id="comboHistogramChannel" style="-fx-font-size: 11px;" />
                            </HBox>
                            <AreaChart fx:id="histogramChart" alternativeRowFillVisible="false" createSymbols="false" horizontalGridLinesVisible="false" horizontalZeroLineVisible="false" legendVisible="false" prefHeight="180.0" style="-fx-background-color: transparent; -fx-padding: 0;" verticalGridLinesVisible="false" verticalZeroLineVisible="false">
                                <xAxis><NumberAxis autoRanging="false" minorTickVisible="false" side="BOTTOM" tickLabelsVisible="false" tickMarkVisible="false" upperBound="255" /></xAxis>
                                <yAxis><NumberAxis minorTickVisible="false" side="LEFT" tickLabelsVisible="false" tickMarkVisible="false" /></yAxis>
                                <VBox.margin><Insets left="-10" right="-10" /></VBox.margin>
                            </AreaChart>
                        </VBox>

                        <!-- PERFIL DE LINEA -->
                        <VBox fx:id="lineProfileContainer" spacing="10.0" style="-fx-background-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 0 0 0 8; -fx-border-color: #007ACC; -fx-border-width: 0 0 0 3;" text="PERFIL DE LÍNEA" />
                            <Label style="-fx-font-size: 11px;" text="Selecciona la herramienta en la barra lateral y haz clic en la imagen." textFill="#E0E0E0" wrapText="true" />
                            <LineChart fx:id="lineProfileChart" alternativeRowFillVisible="false" createSymbols="false" legendVisible="false" prefHeight="180.0" style="-fx-background-color: transparent; -fx-padding: 0;">
                                <xAxis><NumberAxis side="BOTTOM" /></xAxis>
                                <yAxis><NumberAxis side="LEFT" /></yAxis>
                                <VBox.margin><Insets left="-10" right="-10" top="-10" /></VBox.margin>
                            </LineChart>
                            <HBox alignment="CENTER">
                                <Button onAction="#onClearLineProfileClick" style="-fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 5 15 5 15;" text="Limpiar Selección" />
                                <VBox.margin><Insets top="-10" /></VBox.margin>
                            </HBox>
                        </VBox>

                    </VBox>
                </TitledPane>

                <!-- PANEL: REVELADO BÁSICO -->
                <TitledPane fx:id="tpDevelop" expanded="false" style="-fx-font-weight: bold;" text="Revelado Básico">
                    <VBox fx:id="tonalCurveContainer" spacing="15.0" style="-fx-background-color: #383838; -fx-padding: 10;">
                        <VBox spacing="5.0" style="-fx-background-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 0 0 0 8; -fx-border-color: #007ACC; -fx-border-width: 0 0 0 3;" text="CURVA DE TRANSFERENCIA" />
                            <LineChart fx:id="tonalCurveChart" alternativeRowFillVisible="false" createSymbols="false" legendVisible="false" prefHeight="200.0" style="-fx-background-color: transparent;">
                                <xAxis><NumberAxis autoRanging="false" side="BOTTOM" tickUnit="64" upperBound="255" /></xAxis>
                                <yAxis><NumberAxis autoRanging="false" side="LEFT" tickUnit="64" upperBound="255" /></yAxis>
                                <VBox.margin><Insets left="-10" right="-10" /></VBox.margin>
                            </LineChart>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-background-color: #4a4a4a; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Brillo" />
                                <Slider fx:id="sliderBrightness" blockIncrement="0.1" max="1.0" min="-1.0" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtBrightness" alignment="CENTER_RIGHT" prefWidth="55.0" text="0.00" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Contraste" />
                                <Slider fx:id="sliderContrast" blockIncrement="0.1" max="2.0" value="1.0" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtContrast" alignment="CENTER_RIGHT" prefWidth="55.0" text="1.00" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Saturación" />
                                <Slider fx:id="sliderSaturation" blockIncrement="0.1" max="3.0" value="1.0" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtSaturation" alignment="CENTER_RIGHT" prefWidth="55.0" text="1.00" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Gamma" />
                                <Slider fx:id="sliderGamma" blockIncrement="0.1" max="3.0" min="0.1" value="1.0" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtGamma" alignment="CENTER_RIGHT" prefWidth="55.0" text="1.00" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="10.0">
                                <Button onAction="#onApplyBrightnessContrast" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 15 6 15;" text="Aplicar" />
                                <Button onAction="#onResetBrightnessContrast" style="-fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 6 15 6 15;" text="Por defecto" />
                                <VBox.margin><Insets top="10.0" /></VBox.margin>
                            </HBox>
                        </VBox>
                    </VBox>
                </TitledPane>

                <!-- PANEL: UMBRALIZACIÓN -->
                <TitledPane fx:id="tpThreshold" expanded="false" style="-fx-font-weight: bold;" text="Umbralización">
                    <VBox fx:id="thresholdContainer" spacing="15.0" style="-fx-background-color: #383838; -fx-padding: 10;">
                        <CheckBox fx:id="chkApplyThreshold" mnemonicParsing="false" style="-fx-font-weight: bold;" text="Activar Umbralización">
                            <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                        </CheckBox>
                        <VBox spacing="12.0" style="-fx-background-color: #4a4a4a; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <Label text="Tipo de Umbral:" />
                            <ComboBox fx:id="comboThresholdType" maxWidth="Infinity" />
                            <StackPane>
                                <VBox.margin><Insets top="10.0" /></VBox.margin>
                                <VBox fx:id="boxSingleThreshold" spacing="12.0">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label prefWidth="45.0" text="Valor" />
                                        <Slider fx:id="sliderThresholdSingle" blockIncrement="1.0" max="255.0" value="128.0" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtThresholdSingle" alignment="CENTER_RIGHT" prefWidth="55.0" text="128" />
                                    </HBox>
                                </VBox>
                                <VBox fx:id="boxRangeThreshold" spacing="12.0" visible="false">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label prefWidth="45.0" text="Mín" />
                                        <Slider fx:id="sliderThresholdMin" blockIncrement="1.0" max="255.0" value="64.0" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtThresholdMin" alignment="CENTER_RIGHT" prefWidth="55.0" text="64" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label prefWidth="45.0" text="Máx" />
                                        <Slider fx:id="sliderThresholdMax" blockIncrement="1.0" max="255.0" value="192.0" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtThresholdMax" alignment="CENTER_RIGHT" prefWidth="55.0" text="192" />
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </VBox>
                </TitledPane>

                <!-- PANEL: MORFOLOGÍA MATEMÁTICA -->
                <TitledPane fx:id="tpMorphology" expanded="false" style="-fx-font-weight: bold;" text="Morfología Matemática">
                    <VBox spacing="15.0" style="-fx-background-color: #383838; -fx-padding: 10;">
                        <VBox spacing="12.0" style="-fx-background-color: #4a4a4a; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #555555; -fx-border-radius: 6;">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Forma:" textFill="#FFFFFF" />
                                <ComboBox fx:id="comboMorphShape" maxWidth="Infinity" style="-fx-background-color: #1E1E1E; -fx-border-color: #555555; -fx-border-radius: 3; -fx-text-base-color: white;" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefWidth="70.0" text="Tamaño:" textFill="#FFFFFF" />
                                <Spinner fx:id="spinMorphSize" maxWidth="Infinity" style="-fx-background-color: #1E1E1E; -fx-border-color: #555555; -fx-border-radius: 3;" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <Label style="-fx-font-size: 10px;" text="Nota: El tamaño debe ser impar (3x3, 5x5...)." textFill="#CCCCCC" wrapText="true" />
                            <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
                                <Button mnemonicParsing="false" onAction="#onMorphErosionClick" prefWidth="120.0" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;" text="Erosión" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Button mnemonicParsing="false" onAction="#onMorphDilationClick" prefWidth="120.0" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;" text="Dilatación" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Button mnemonicParsing="false" onAction="#onMorphOpeningClick" prefWidth="120.0" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;" text="Apertura" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Button mnemonicParsing="false" onAction="#onMorphClosingClick" prefWidth="120.0" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;" text="Cierre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </GridPane>
                        </VBox>
                    </VBox>
                </TitledPane>

                <!-- PANEL: HISTORIAL DE CAMBIOS -->
                <TitledPane expanded="false" style="-fx-font-weight: bold;" text="Historial de Cambios">
                    <VBox fx:id="historyPanel" prefHeight="250.0" spacing="10.0" style="-fx-background-color: #383838; -fx-padding: 10;">
                        <ListView fx:id="listHistory" VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER">
                            <Button fx:id="btnRestoreHistory" mnemonicParsing="false" onAction="#onRestoreHistoryClick" style="-fx-base: #007ACC; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 8;" text="Restaurar Estado" />
                        </HBox>
                    </VBox>
                </TitledPane>

            </VBox>
        </ScrollPane>
    </right>

    <!-- 5. BARRA INFERIOR (Estado) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #222222;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="6.0" left="12.0" right="12.0" top="6.0" /></padding>
            <Label fx:id="lblStatus" text="Listo" textFill="#FFFFFF"><font><Font name="System Bold" size="12.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblPixelInfo" style="-fx-font-family: 'Consolas', monospace;" textFill="#E0E0E0"><font><Font size="12.0" /></font></Label>
            <Rectangle fx:id="rectPixelColor" arcHeight="4" arcWidth="4" height="14" stroke="#FFFFFF" strokeType="OUTSIDE" visible="false" width="14" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblImageInfo" textFill="#FFFFFF"><padding><Insets right="10.0" /></padding><font><Font name="System Bold" size="12.0" /></font></Label>
        </HBox>
    </bottom>
</BorderPane>